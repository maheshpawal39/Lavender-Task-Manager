# PostgreSQL connection string (required). Never commit real credentials.
DATABASE_URL=postgresql://user:password@localhost:5432/lavender

# Flask session signing key (required in production).
SECRET_KEY=replace-with-a-long-random-string

# Allowed frontend origin(s), comma-separated.
FRONTEND_URL=http://localhost:5173

# Local HTTP development. Use true behind HTTPS (Vercel).
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Connection pool tuning (optional).
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3
DB_POOL_RECYCLE=280
DB_POOL_TIMEOUT=10
DB_CONNECT_TIMEOUT=5

# Set to true when using a transaction-mode pooler (PgBouncer / Neon pooler).
DB_DISABLE_PREPARED_STATEMENTS=false
